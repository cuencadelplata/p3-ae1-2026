# Copiar como .env y ajustar segun el entorno. El archivo .env no se versiona (RNF-11).

NODE_ENV=development
PORT=3008
SERVICE_VERSION=2.3.0

# Rutas publicas
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:3008

# Origenes permitidos por CORS: "*" o una lista separada por comas
CORS_ORIGIN=*

# Conexion a PostgreSQL con el rol propio del servicio (esquema "receipts").
# Levantar la base con: docker compose up -d postgres (desde modulo-8)
RECEIPTS_DATABASE_URL=postgres://m8_receipts:m8_receipts_local@localhost:5432/m8

# Redis para los enlaces temporales de descarga del PDF. Levantar con: docker compose up -d redis
REDIS_URL=redis://localhost:6379
RECEIPT_LINK_TTL_SECONDS=900

# Mensajeria (catalogo de eventos v1). Levantar el broker con: docker compose up -d rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENTS_EXCHANGE=mobility.events
EVENTS_DEAD_LETTER_EXCHANGE=mobility.events.dlx
PAYMENT_CONFIRMED_QUEUE=m8.receipts.payment-confirmed
CONSUMER_PREFETCH=5
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=5000
# Publicacion de receipt.issued desde la bandeja de salida
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# Espera entre intentos de preparar el esquema si PostgreSQL no responde al arrancar
DATABASE_STARTUP_RETRY_MS=3000

# Autorizador fiscal externo (simulado). Levantar con: docker compose up -d fiscal-sandbox
FISCAL_API_URL=http://localhost:4010
FISCAL_TIMEOUT_MS=2000
# Circuit breaker: fallas seguidas que lo abren y tiempo que permanece abierto
FISCAL_CIRCUIT_FAILURE_THRESHOLD=3
FISCAL_CIRCUIT_OPEN_MS=10000

# API de pagos de M7 (simulada). Levantar con: docker compose up -d m7-payments-sandbox
M7_PAYMENTS_URL=http://localhost:4020
M7_TIMEOUT_MS=2000

# Datos de presentacion dentro del comprobante
RECEIPT_ISSUER_NAME=Plataforma de Movilidad Urbana
RECEIPT_ISSUER_TEAM=Grupo 14 - Modulo 8
RECEIPT_TIMEZONE=America/Argentina/Buenos_Aires
RECEIPT_LOCALE=es-AR
