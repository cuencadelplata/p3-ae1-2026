{
  "name": "m8-documentos",
  "version": "2.3.0",
  "description": "M8 - Notificaciones, Documentos y Soporte. Emision y consulta de comprobantes de viaje en PDF.",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "prueba:concurrencia": "node scripts/prueba-concurrencia.mjs",
    "prueba:replicas": "node scripts/prueba-concurrencia.mjs http://localhost:3008 http://localhost:3018",
    "demo:pago": "node scripts/publicar-pago-confirmado.mjs",
    "test:all": "pnpm run typecheck && pnpm run typecheck:test && pnpm run test && pnpm run prueba:concurrencia",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "microservicio",
    "comprobantes",
    "pdf"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.18",
    "amqplib": "^0.10.9",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/yamljs": "^0.2.34",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
