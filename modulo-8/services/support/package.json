{
  "name": "m8-soporte",
  "version": "1.0.0",
  "description": "Módulo 8: Soporte y RabbitMQ",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "prueba:resiliencia": "node --test scripts/prueba-resiliencia-broker.mjs",
    "prueba:resiliencia:db": "node --test scripts/prueba-resiliencia-db.mjs"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.18",
    "amqplib": "^0.10.4",
    "express": "5.0.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.3",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "playwright": "^1.46.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
