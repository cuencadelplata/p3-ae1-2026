# Puerto del host publicado por Docker Compose. No se utiliza dentro de Node.
M8_HOST_PORT=3000

# Puerto donde escucha Node al ejecutar localmente fuera de Compose. Compose fija
# intencionalmente el puerto interno del contenedor en 3000.
PORT=3000

# Vida útil de los QR temporales, expresada en segundos.
QR_TTL_SECONDS=300

# PostgreSQL compartido por M8. Cada servicio usa su propio esquema y rol.
# La contraseña por defecto es solo para desarrollo local: definir una propia
# en .env fuera de ese entorno.
POSTGRES_DB=m8
POSTGRES_USER=m8_admin
POSTGRES_PASSWORD=m8_admin_local
POSTGRES_HOST_PORT=5432

# Rol propio del servicio de comprobantes (esquema "receipts"). PostgreSQL lo
# crea solo al inicializar un volumen vacío: si se cambia, recrear el volumen
# con "docker compose down -v".
RECEIPTS_DB_PASSWORD=m8_receipts_local

# Rol propio del servicio de notificaciones (esquema "notifications").
# PostgreSQL lo crea al inicializar un volumen vacio. Si el volumen ya existe,
# ejecutar manualmente el init script documentado en services/notifications.
NOTIFICATIONS_DB_PASSWORD=m8_notifications_local

# Redis compartido por M8. Cada servicio usa su propio prefijo de claves.
REDIS_HOST_PORT=6379
# Vigencia de los enlaces temporales de descarga del PDF, en segundos.
RECEIPT_LINK_TTL_SECONDS=900

# Autorizador fiscal simulado (servicio externo del comprobante).
FISCAL_HOST_PORT=4010
# Modo inicial: normal, slow (demora SLOW_DELAY_MS) o down (responde 503).
FISCAL_MODE=normal
FISCAL_SLOW_DELAY_MS=5000

# API de pagos de M7 simulada (fuente de verdad del estado del pago).
M7_HOST_PORT=4020
# Modo inicial: normal, slow o down, igual que el autorizador fiscal.
M7_MODE=normal
# Viaje sin pago registrado: autorizado (demostracion) o not_found (como M7).
M7_UNREGISTERED_TRIPS=autorizado
