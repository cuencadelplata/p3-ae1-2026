# Variables del stack comun (docker-compose.yml de la raiz).
# Copiar como .env en la raiz:  cp .env.example .env
# El .env esta en .gitignore: no subir claves reales al repositorio.
#
# Todas las demas variables tienen un valor por defecto en los compose de cada modulo.
# Para ver la lista completa con sus valores por defecto:  docker compose config --variables

# --- Identidad compartida ------------------------------------------------------------------
# Clave con la que M1 firma los JWT. Todos los modulos la usan para validar los tokens,
# por eso tiene que ser la misma en todo el stack. Sin esta variable `docker compose up` falla.
JWT_SECRET=cambiar-por-una-clave-larga
# Alternativa: definir M1_JWT_SECRET (tiene prioridad sobre JWT_SECRET).
# M1_JWT_SECRET=

# --- Test integral (tests-integracion/) -------------------------------------------------------
# M4 real resuelve las direcciones. "stub" es solo para pruebas aisladas.
ROUTE_RESOLVER_MODE=m4

# --- Integracion entre modulos --------------------------------------------------------------
# QR e inicio de viaje: definir QR_INTERNAL_API_KEY (mínimo 16 caracteres).
# Pagos y comprobantes: M7_API_KEY también va en modulo7/.env, con el mismo valor.
# Para pagar con tarjeta desde el frontend, usar una clave pública del entorno TEST de M7.
# M1_INTERNAL_API_KEY=
# M5_SERVICE_TOKEN=
# M6_INTERNAL_API_KEY=
# M7_API_KEY=
# QR_INTERNAL_API_KEY=
# MP_PUBLIC_KEY=
# M2_INTERNAL_API_KEY=
# M2_SOPORTE_SECRET_KEY=

# --- M9: activacion con token delegado emitido por M1 --------------------------------------
M9_DISPATCH_AUTH_URL=http://m1-identidad-acceso:3001/auth/token-delegado
# Generar una credencial privada para el entorno. Compose la pasa a M1 y M9.
# M9_DISPATCH_AUTH_TOKEN=
# M9_DEMO_AUTH_SECRET=

# --- M1: inicio de sesion con proveedores externos (opcional) --------------------------------
# M1_GOOGLE_CLIENT_ID=
# M1_GOOGLE_CLIENT_SECRET=
# M1_AUTH0_DOMAIN=
# M1_AUTH0_CLIENT_ID=
# M1_AUTH0_CLIENT_SECRET=

# --- M8: correo y notificaciones push (opcional) ---------------------------------------------
# Los valores locales de PostgreSQL alcanzan para un clon nuevo.
# Las variables privadas y los puertos están documentados en modulo8/integracion.env.example.
# M8_SMTP_USER=
# M8_SMTP_PASSWORD=
# M8_MAIL_FROM=
# M8_VAPID_PUBLIC_KEY=
# M8_VAPID_PRIVATE_KEY=

# --- Observabilidad (opcional) ---------------------------------------------------------------
# GRAFANA_CLOUD_REMOTE_WRITE_URL=
# GRAFANA_CLOUD_USER=
# GRAFANA_CLOUD_TOKEN=
# M6_OTEL_ENDPOINT=
