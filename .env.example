# Solo para ejecutar M9 directamente con npm; Docker obtiene credenciales de Supabase local automáticamente.
NODE_ENV=development
PORT=3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=replace-with-local-service-role-key
M5_URL=http://localhost:3001
M7_URL=http://localhost:3002
RESERVATION_JOB_INTERVAL=*/30 * * * * *
