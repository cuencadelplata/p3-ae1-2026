PORT=3001
JWT_SECRET=reemplazar-por-una-clave-segura
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicación
SMTP_FROM=tu-cuenta@gmail.com

# RF-1.2 - Rate limiting de login con Redis
REDIS_URL=redis://localhost:6379
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEGUNDOS=60
# Poner en true solo si la API está detrás de un proxy que envía X-Forwarded-For
TRUST_PROXY=false

# RF-1.2 - Eventos asincrónicos en RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# RF-1.4 - Tiempo de vida del token de recuperación en Redis (15 minutos)
RECUPERACION_TTL_SEGUNDOS=900
# Backing Services - Proveedores de Identidad OAuth2 / OpenID Connect (RF-1.5)
DEFAULT_OAUTH2_PROVIDER=mock

# Google Identity (OAuth2 / OIDC)
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/oauth2/callback

# Auth0 (OpenID Connect)
AUTH0_DOMAIN=tu-auth0-domain.auth0.com
AUTH0_CLIENT_ID=tu-auth0-client-id
AUTH0_CLIENT_SECRET=tu-auth0-client-secret
AUTH0_REDIRECT_URI=http://localhost:3001/auth/oauth2/callback
