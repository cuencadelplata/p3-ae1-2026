          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Memoria de M1",
      "description": "Soporte: memoria que usa el proceso de M1.",
