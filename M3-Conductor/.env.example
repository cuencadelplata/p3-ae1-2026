# Puerto HTTP del servidor Express
PORT=3000

# Redis (caché de habilitación RF 3.1 + estado efímero de disponibilidad RF 3.3)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# TTL en segundos de la caché de habilitación (RF 3.1). Al vencer se vuelve a
# consultar la base de datos.
REDIS_TTL_HABILITADO=300

# TTL en segundos del heartbeat de disponibilidad (RF 3.3). Si el conductor no
# refresca su estado antes de que expire, deja de figurar como disponible.
REDIS_TTL_DISPONIBLE=60

# Supabase (base de datos persistente, fuente de verdad de la habilitación).
# Si se dejan vacías, el módulo cae a un fallback en memoria (sólo para
# desarrollo/tests), pero NUNCA debe quedar así en producción.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RabbitMQ (RNF-07): eventos asíncronos DriverAvailabilityUpdated y
# DriverStatusChanged. Ver docs/EVENTOS.md.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=m3.conductores.events
# Cola usada por el consumidor de ejemplo (npm run consumer)
RABBITMQ_EXAMPLE_QUEUE=m3.ejemplo.driver-events
