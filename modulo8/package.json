{
  "name": "@m8/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present run build && tsc -p tsconfig.json",
    "check:secrets": "node scripts/check-public-config.mjs",
    "start:unified": "node dist/server.js",
    "ensure:dependencies": "node scripts/ensure-test-infrastructure.mjs dependencies",
    "ensure:stack": "node scripts/ensure-test-infrastructure.mjs stack",
    "test": "pnpm run ensure:dependencies && pnpm run build && pnpm -r --workspace-concurrency=1 --if-present run test && pnpm run test:unified && pnpm run test:notifications:integration",
    "test:unified": "node --test tests/integration/m8-application.test.mjs tests/integration/openapi-consistency.test.mjs tests/integration/runtime-config.test.mjs",
    "test:notifications": "pnpm --filter @m8/notifications-processing run test",
    "test:notifications:integration": "pnpm --filter @m8/notifications-processing run test:integration",
    "test:qr": "pnpm --filter @m8/qr run test",
    "test:receipts": "pnpm --filter m8-documentos run test",
    "test:support": "pnpm --filter m8-soporte run test",
    "test:delivery": "pnpm --filter @m8/notification-delivery run test",
    "test:e2e": "pnpm run ensure:stack && node --test --test-concurrency=1 tests/e2e/infrastructure-ae2.e2e.test.mjs tests/e2e/receipts-ae2.e2e.test.mjs tests/e2e/workspace-api.e2e.test.mjs && pnpm run test:resiliencia:raw",
    "test:infrastructure": "pnpm run ensure:dependencies && node --test tests/e2e/infrastructure-ae2.e2e.test.mjs",
    "test:resiliencia": "pnpm run ensure:stack && pnpm run test:resiliencia:raw",
    "test:resiliencia:raw": "node --test tests/e2e/resiliencia-ae2.e2e.test.mjs",
    "compose:build": "docker compose build",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down --remove-orphans",
    "db:studio": "prisma studio --config infra/db-ui/prisma.config.ts",
    "smoke:http": "node tests/stress/run-k6.mjs http",
    "smoke:qr": "node tests/stress/run-k6.mjs qr",
    "smoke:receipts": "node tests/stress/run-k6.mjs receipts",
    "smoke:support": "node tests/stress/run-k6.mjs support",
    "smoke:delivery": "node tests/stress/run-k6.mjs delivery",
    "load:fullflow600": "node tests/stress/run-k6.mjs http 600 600",
    "load:support": "node tests/stress/run-load.mjs support",
    "load:qr": "node tests/stress/run-load.mjs qr",
    "load:receipts": "node tests/stress/run-load.mjs receipts",
    "load:resend": "node tests/stress/run-load.mjs resend",
    "load:delivery": "node tests/stress/run-load.mjs delivery",
    "load:mixed": "node tests/stress/run-load.mjs mixed",
    "load:capacity": "node tests/stress/run-capacity.mjs",
    "load:ramp45": "node tests/stress/run-load.mjs mixed step45 600",
    "scenario:m3": "node tests/e2e/m3-document-flow.mjs",
    "load:m3": "node tests/stress/run-m3-batch.mjs",
    "scenario:errors": "node tests/stress/run-errors.mjs"
  },
  "dependencies": {
    "@m8/notification-delivery": "workspace:*",
    "@m8/notifications-processing": "workspace:*",
    "@m8/qr": "workspace:*",
    "@m8/shared": "workspace:*",
    "@scalar/express-api-reference": "^0.10.18",
    "amqplib": "^0.10.9",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "m8-documentos": "workspace:*",
    "m8-soporte": "workspace:*",
    "nodemailer": "6.10.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "web-push": "3.6.7",
    "yaml": "^2.5.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^7.0.2"
  }
}
