# Plantilla pública: los textos replace-with-* no son credenciales utilizables.
# Crear un .env local ignorado por Git o inyectar secretos desde el entorno.

# Puerto del host publicado por Docker Compose. No se utiliza dentro de Node.
M8_HOST_PORT=8000
# Imagen de la aplicación M8. Sin definir, Compose construye/usa la imagen local.
# Para ejecutar una versión publicada, asignar por ejemplo:
# M8_IMAGE=juanmainval/m8-notificaciones-qr:2.0.0
# M8_IMAGE=modulo-8-m8-app:local

# Puerto donde escucha Node al ejecutar localmente fuera de Compose. Compose fija
# intencionalmente el puerto interno del contenedor en 3000.
PORT=3000

# Broker local de demostración. En otros entornos proveer estos valores fuera
# del repositorio. La URL interna usa el nombre del servicio de Compose.
RABBITMQ_USER=replace-with-local-rabbit-user
RABBITMQ_PASSWORD=replace-with-local-rabbit-password
# URL del proceso M8 dentro de Compose y URL de herramientas en el host.
M8_RABBITMQ_URL=amqp://replace-with-local-rabbit-user:replace-with-local-rabbit-password@rabbitmq:5672
RABBITMQ_URL=amqp://replace-with-local-rabbit-user:replace-with-local-rabbit-password@localhost:5672

# Vida útil de los QR temporales, expresada en segundos.
QR_TTL_SECONDS=300
# Tiempo que un QR vencido se conserva para responder 410 antes de pasar a 404, en segundos.
QR_EXPIRED_GRACE_SECONDS=3600
QR_INTERNAL_API_KEY=replace-with-local-dev-qr-api-key

# PostgreSQL compartido por M8. Cada servicio usa su propio esquema y rol.
# Definir contraseñas propias en .env fuera de Git.
POSTGRES_DB=m8
POSTGRES_USER=m8_admin
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_HOST_PORT=5432

# Rol propio del servicio de comprobantes (esquema "receipts"). PostgreSQL lo
# crea solo al inicializar un volumen vacío: si se cambia, recrear el volumen
# con "docker compose down -v".
RECEIPTS_DB_PASSWORD=replace-with-local-receipts-db-password

# Rol propio del servicio de notificaciones (esquema "notifications").
# El entorno de pruebas usa una base exclusiva para poder limpiar su schema sin
# afectar la aplicacion ni los demas RF.
NOTIFICATIONS_DB_PASSWORD=replace-with-local-notifications-db-password
NOTIFICATIONS_TEST_DB_NAME=m8_notifications_test

# Rol propio del servicio de soporte (esquema "support"). PostgreSQL lo crea
# solo al inicializar un volumen vacío. En un volumen que ya existía, aplicarlo
# ejecutando manualmente su init script.
SUPPORT_DB_PASSWORD=replace-with-local-support-db-password

# Redis compartido por M8. Cada servicio usa su propio prefijo de claves.
REDIS_HOST_PORT=6379
# Vigencia de los enlaces temporales de descarga del PDF, en segundos.
RECEIPT_LINK_TTL_SECONDS=900

# Autorizador fiscal simulado (servicio externo del comprobante).
FISCAL_HOST_PORT=4010
# Modo inicial: normal, slow (demora SLOW_DELAY_MS) o down (responde 503).
FISCAL_MODE=normal
FISCAL_SLOW_DELAY_MS=5000

# API de pagos de M7 simulada (fuente de verdad del estado del pago).
M7_HOST_PORT=4020
# Para la integración con M7 real, configurar M7_PAYMENTS_URL fuera de Git.
# M7 real exige x-api-key. Configurar M7_API_KEY con el valor compartido en privado;
# el sandbox local no la necesita. No guardar la clave real en este archivo.
# Sin definirla, M8 consulta el sandbox local.
# Modo inicial: normal, slow o down, igual que el autorizador fiscal.
M7_MODE=normal
# Viaje sin pago registrado: autorizado (demostracion) o not_found (como M7).
M7_UNREGISTERED_TRIPS=autorizado

# RF8.7 - Entrega de notificaciones (esquema "notification_delivery")
DELIVERY_DB_PASSWORD=replace-with-local-delivery-db-password
DELIVERY_HOST_PORT=3107

# Integración interna con M2 (preferencias de cliente). En producción definir
# explícitamente ambas credenciales fuera del repositorio: no hay defaults.
M2_API_URL=http://m2-preferences-sandbox:4012
M2_TIMEOUT_MS=3000
M2_INTERNAL_API_KEY=replace-with-local-dev-api-key

# Validación JWT de M1. El secreto o mecanismo equivalente debe ser provisto
# externamente en producción; sin él, los endpoints protegidos fallan cerrado.
M1_JWT_SECRET=replace-with-local-dev-jwt-secret

# RF8.4: endpoint M1 que valida el Bearer del usuario para consulta,
# descarga y reenvío. No se usa para emitir comprobantes ni como M2M.
# M1_IDENTITY_URL=http://localhost:3001/auth/validar-identidad-y-rol
M1_TIMEOUT_MS=2000

# Opcional: API interna de M3-Conductor para agregar nombre al aviso de
# asignación. Configurar sólo cuando M3 sea accesible en la misma red.
# M3_CONDUCTOR_BASE_URL=http://m3-conductor:3000
# Opcional: M3-Vehículos; URL interna en el Compose común.
# M3_VEHICLES_BASE_URL=http://m3-vehiculos:8083

# Observabilidad - Grafana Cloud (Prometheus Remote Write)
GRAFANA_CLOUD_REMOTE_WRITE_URL=replace-with-your-prometheus-remote-write-url
GRAFANA_CLOUD_USER=replace-with-your-instance-id
GRAFANA_CLOUD_TOKEN=replace-with-your-token
