# Copiar a modulo8/.env.integracion y completar fuera de Git.
# Desde la raíz: docker compose --env-file modulo8/.env.integracion up -d --build m8-app
# Contraseñas usadas en URLs: usar caracteres alfanuméricos o codificar los reservados.
M8_HOST_PORT=18000
M8_PUBLIC_BASE_URL=http://localhost:18000
M8_POSTGRES_PASSWORD=replace-with-m8-admin-password
M8_NOTIFICATIONS_DB_PASSWORD=replace-with-m8-notifications-password
M8_RECEIPTS_DB_PASSWORD=replace-with-m8-receipts-password
M8_SUPPORT_DB_PASSWORD=replace-with-m8-support-password
M8_DELIVERY_DB_PASSWORD=replace-with-m8-delivery-password
# M6 toma esta misma variable desde su compose.integracion.yml.
# Mínimo 16 caracteres. Compartir el valor por un canal privado.
QR_INTERNAL_API_KEY=replace-with-shared-m6-m8-qr-key
M1_JWT_SECRET=replace-with-m1-jwt-secret
M2_INTERNAL_API_KEY=replace-with-m2-internal-key
# Las credenciales del broker deben coincidir con el RabbitMQ del stack común.
# Dejarlas escritas aunque sean las de por defecto: Compose también lee
# modulo8/.env (el del entorno aislado, con guest) para el archivo incluido, y
# sin estas líneas M8 entra a RabbitMQ como guest y el broker lo rechaza.
RABBITMQ_USER=m9
RABBITMQ_PASSWORD=m9-local
# Clave que M7 acordó con M6 y M8.
M7_API_KEY=replace-with-m7-api-key
# RF-8.7 push real a navegadores. Generar el par con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"   (desde services/notification-delivery)
M8_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
M8_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
# Correo de recuperación de M1 por Gmail: cuenta y contraseña de aplicación
# (Cuenta de Google > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones).
M8_SMTP_USER=replace-with-gmail-address
M8_SMTP_PASSWORD=replace-with-gmail-app-password
M8_MAIL_FROM=replace-with-gmail-address
# Las integraciones de otros RF se configuran cuando sus servicios estén disponibles.
# M8_M1_IDENTITY_URL=http://m1-identidad-acceso:3001/auth/validar-identidad-y-rol
# M8_M2_API_URL=http://m2-api:3000
# M8_M7_PAYMENTS_URL=http://m7-api:3000
# Por defecto el Compose común ya apunta a estos servicios (cambiar solo si se renombran):
# M8_M6_TRIPS_URL=http://m6-viajes:3000
# M8_M3_CONDUCTOR_BASE_URL=http://m3-conductor-api:3000
# M8_M3_VEHICLES_BASE_URL=http://m3-vehiculos:8083
