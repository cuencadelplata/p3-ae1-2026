# Configuración de Entorno — Módulo 5 (AE2)
PORT=3005
NODE_ENV=development

# Base de Datos Relacional (PostgreSQL / DispatchDB - RNF-04)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dispatch_db?schema=public

# Redis (RNF-06 / Cache, TTL e invalidación de ofertas / locks de concurrencia)
REDIS_URL=redis://localhost:6379
DISABLE_REDIS=false

# RabbitMQ (RNF-07 / Publicación asíncrona de eventos de cancelación previa y ofertas)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DISABLE_RABBITMQ=false
