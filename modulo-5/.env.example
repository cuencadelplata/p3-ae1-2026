# Configuración de Servidor
PORT=3005
NODE_ENV=development

# Configuración de Redis (Caché y TTL de ofertas - RNF-06)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Opcionalmente vía URI completa:
REDIS_URL=redis://localhost:6379

# Configuración de RabbitMQ (Mensajería asíncrona - RNF-07)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Configuración de Base de Datos Relacional (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dispatch_db?schema=public

# Configuración de Módulo 4 (Ubicación y Disponibilidad)
M4_SERVICE_URL=http://localhost:3004

