      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": " Tiempo de Respuesta Promedio por Endpoint (Milisegundos)",
          "description": "Cuánto tarda el servidor M8 en responder cada petición por ruta",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "(sum by (rf, route) (http_request_duration_seconds_sum{service=\"m8-app\", rf=~\"$rf\"}) / sum by (rf, route) (http_request_duration_seconds_count{service=\"m8-app\", rf=~\"$rf\"})) * 1000",
                        "legendFormat": "[{{rf}}] {{route}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
