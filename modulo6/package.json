{
  "name": "p3-ae1-2026-modulo6",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/rf-6.1-6.2-6.3/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:rf-6.1-6.2-6.3": "vitest run --config vitest.config.ts tests/rf-6.1-6.2-6.3",
    "test:rf-6.4-6.7": "vitest run --config vitest.config.ts tests/rf-6.4-6.7",
    "test:rf-6.5-6.6": "vitest run --config vitest.config.ts tests/rf-6.5-6.6",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all-rf": "node scripts/test-all-rf.mjs",
    "test:e2e:rf-6.1-6.2-6.3": "vitest run --config vitest.e2e.config.ts tests-e2e/rf-6.1-6.2-6.3",
    "test:e2e:rf-6.4-6.7": "vitest run --config vitest.e2e.config.ts tests-e2e/rf-6.4-6.7",
    "test:e2e:rf-6.5-6.6": "vitest run --config vitest.e2e.config.ts tests-e2e/rf-6.5-6.6",
    "test:e2e:resilience": "vitest run --config vitest.e2e.config.ts tests-e2e/rf-6.4-6.7 -t \"keeps API alive while M4 is stopped\"",
    "k6:smoke": "k6 run --env K6_PROFILE=smoke k6/viajes.js",
    "k6:load": "k6 run --env K6_PROFILE=load k6/viajes.js",
    "k6:stress": "k6 run --env K6_PROFILE=stress k6/viajes.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:integration:up": "node scripts/start-integracion.mjs",
    "docker:e2e:up": "docker compose -f docker-compose.yml -f docker-compose.rf-e2e.yml up -d --build --wait",
    "docker:e2e:down": "docker compose -f docker-compose.yml -f docker-compose.rf-e2e.yml down",
    "test:frontend": "node tests-frontend/cancelacion-flujo.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
