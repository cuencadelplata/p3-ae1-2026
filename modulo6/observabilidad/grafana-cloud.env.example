# Copiar como modulo6/.env (ignorado por Git) y completar con los datos de la cuenta
# de Grafana Cloud del equipo. No subir este archivo con valores reales.
#
#   docker compose --profile observability up -d
#
# Elegir la configuración de Alloy que también envía a Grafana Cloud:
ALLOY_CONFIG=config.cloud.alloy

# Grafana Cloud → Connections → Prometheus → "Remote Write Endpoint" y "Username / Instance ID"
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=000000

# Grafana Cloud → Connections → OpenTelemetry (OTLP) → "OTLP Endpoint" e "Instance ID"
GRAFANA_CLOUD_OTLP_URL=https://otlp-gateway-prod-XX.grafana.net/otlp
GRAFANA_CLOUD_OTLP_USER=000000

# Access Policy token con alcances metrics:write, logs:write y traces:write
GRAFANA_CLOUD_TOKEN=reemplazar-por-token-privado

# Contraseña del admin del Grafana local (http://localhost:3003)
GRAFANA_ADMIN_PASSWORD=admin

# URL accesible desde el contenedor M6 y clave interna compartida con M7
M7_URL=
M7_API_KEY=

# Puertos publicados del stack de observabilidad (cambiarlos si chocan con otro módulo)
# M6_GRAFANA_PORT=3003
# M6_PROMETHEUS_PORT=9090
# M6_LOKI_PORT=3100
# M6_TEMPO_PORT=3200
# M6_ALLOY_PORT=12345
