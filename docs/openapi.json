{
  "openapi": "3.0.3",
  "info": {
    "title": "AE2 · M2 Clientes · RF-2.2",
    "version": "2.2.0",
    "description": "Extiende la base RF-2.4. Identidad de demo con token HMAC; no equivale a proveedor OAuth2/OIDC productivo. Recientes llegan por evento M6, no por un endpoint público que permita falsificar viajes."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
