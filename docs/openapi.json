    "/api/v1/direcciones/desde-viaje": {
      "post": {
        "operationId": "importarDireccionesDeViaje",
        "summary": "Reutiliza cliente M6 de RF-2.4 para importar direcciones de un viaje propio completado",
        "description": "Consulta GET /api/viajes/{viajeId}, ruta existente en el cliente heredado. Acepta origen/destino textuales del contrato recibido y puntos del simulador anterior. No requiere coordenadas ni completadoAt. Usa completadoAt si existe, si no fechaCreacion/createdAt y finalmente fecha de primera importación, etiquetando la fuente. Idempotente por viajeId junto a RabbitMQ. No crea viajes ni necesita calificación.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "viajeId"
                ],
                "properties": {
                  "viajeId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sincronizado; repetir no duplica usos"
          },
          "400": {
            "description": "Body inválido"
          },
          "401": {
            "description": "Sin identidad"
          },
          "404": {
            "description": "Viaje inexistente o ajeno"
          },
          "409": {
            "description": "Viaje no completado o conflicto concurrente"
          },
          "502": {
            "description": "M6 no devolvió identidad/origen/destino válidos"
          },
          "503": {
            "description": "M6 o DB no disponible"
          }
        }
      }
    },
    "/api/v1/direcciones/sugerencias": {
      "get": {
        "operationId": "sugerirOrigenDestino",
        "summary": "Sugiere ambos extremos usando favoritos y recientes propios; propone B → A para volver",
        "description": "Sin llamadas a M6; lee datos locales. Usa último viaje completado importado conocido, no ubicación GPS ni historial completo de M6. La persona confirma ambos extremos.",
        "responses": {
          "200": {
            "description": "Listas vacías y regreso null si no hay información; no se inventan lugares.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "origenes",
                        "destinos",
                        "regreso"
                      ],
                      "properties": {
                        "origenes": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Punto"
                          }
                        },
                        "destinos": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Punto"
                          }
                        },
                        "regreso": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "viajeId": {
                              "type": "string"
                            },
                            "origen": {
                              "$ref": "#/components/schemas/Punto"
                            },
                            "destino": {
                              "$ref": "#/components/schemas/Punto"
                            },
                            "fechaViaje": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "fechaReferencia": {
                              "type": "string",
                              "enum": [
                                "FINALIZACION",
                                "CREACION",
                                "IMPORTACION"
                              ]
                            },
                            "requiereConfirmacion": {
                              "type": "boolean",
                              "enum": [
                                true
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Identidad inválida"
          },
          "503": {
            "description": "DB no disponible"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de scripts/token.cjs (payload.firma), no JWT estándar."
      }
    },
    "schemas": {
      "Punto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direccion"
        ],
        "properties": {
          "direccion": {
            "type": "string",
            "minLength": 3,
            "maxLength": 250
          },
          "latitud": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "nullable": true
          },
          "longitud": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "nullable": true
          }
        },
        "description": "Dirección textual; coordenadas opcionales. Si se informan, deben venir ambas."
      },
      "CrearDireccion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direccion",
          "tipo"
        ],
        "properties": {
          "direccion": {
            "type": "string",
            "minLength": 3,
            "maxLength": 250
          },
          "latitud": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "nullable": true
          },
          "longitud": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "nullable": true
          },
          "tipo": {
            "type": "string",
            "enum": [
              "ORIGEN",
              "DESTINO"
            ]
          },
          "etiqueta": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "description": "Dirección textual; coordenadas opcionales. Si se informan, deben venir ambas."
      },
      "EditarDireccion": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "etiqueta": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "favorita": {
            "type": "boolean"
          }
        }
      },
      "Direccion": {
        "type": "object",
        "properties": {
          "direccion": {
            "type": "string",
            "minLength": 3,
            "maxLength": 250
          },
          "latitud": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "nullable": true
          },
          "longitud": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "nullable": true
          },
          "tipo": {
            "type": "string",
            "enum": [
              "ORIGEN",
              "DESTINO"
            ]
          },
          "etiqueta": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clienteId": {
            "type": "string"
          },
          "clave": {
            "type": "string"
          },
          "favorita": {
            "type": "boolean"
          },
          "usos": {
            "type": "integer"
          },
          "ultimoUso": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "version": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
