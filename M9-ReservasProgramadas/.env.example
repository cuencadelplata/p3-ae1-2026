NODE_ENV=development
PORT=3000
M5_BASE_URL=http://localhost:3001
M7_BASE_URL=http://localhost:3002
M5_TIMEOUT_MS=3000
M7_TIMEOUT_MS=3000
DISPATCH_MODE=events
# Token de servicio provisto por M1/entorno. No versionar valores reales.
M5_SERVICE_TOKEN=
# "blocked" en producción hasta acordar M4; "stub" solo para pruebas locales/E2E.
ROUTE_RESOLVER_MODE=blocked
ROUTE_STUB_ORIGIN_LATITUDE=-27.4514
ROUTE_STUB_ORIGIN_LONGITUDE=-58.9867
ROUTE_STUB_DESTINATION_LATITUDE=-27.4692
ROUTE_STUB_DESTINATION_LONGITUDE=-58.8306
ROUTE_STUB_DISTANCE_KM=18.4
ROUTE_STUB_DURATION_MIN=28
DATABASE_URL=postgresql://m9:m9-local@localhost:5432/m9_reservas?schema=public
POSTGRES_DB=m9_reservas
POSTGRES_USER=m9
POSTGRES_PASSWORD=m9-local
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_CACHE_TTL_SECONDS=60
REDIS_LOCK_TTL_MS=10000
RABBITMQ_URL=amqp://m9:m9-local@localhost:5672
RABBITMQ_USER=m9
RABBITMQ_PASSWORD=m9-local
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PORT=5672
RABBITMQ_EXCHANGE=m9.reservas.events
RABBITMQ_RETRY_EXCHANGE=m9.reservas.events.retry
RABBITMQ_DLQ_EXCHANGE=m9.reservas.events.dlx
RABBITMQ_QUEUE=m9.reservas
RABBITMQ_RETRY_QUEUE=m9.reservas.retry
RABBITMQ_DLQ=m9.reservas.dlq
RABBITMQ_RETRY_LIMIT=3
RABBITMQ_RETRY_DELAY_MS=1000
OUTBOX_POLL_INTERVAL_MS=5000
RESERVATION_JOB_INTERVAL=*/5 * * * * *
