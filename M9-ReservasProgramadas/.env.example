NODE_ENV=development
PORT=3000
M9_AUTH_MODE=m1
M1_BASE_URL=http://localhost:3001
M1_TIMEOUT_MS=3000
# Emisor delegado pendiente de contrato con M1: no usar JWT de pasajeros.
M9_DISPATCH_AUTH_URL=
M9_DISPATCH_AUTH_TOKEN=
ACTIVATION_RECOVERY_TIMEOUT_MS=120000
M5_BASE_URL=http://localhost:3005
M5_STUB_PORT=3001
M7_BASE_URL=http://localhost:17000
M5_TIMEOUT_MS=3000
M7_TIMEOUT_MS=3000
DISPATCH_MODE=rest
# Token de servicio provisto por M1/entorno. No versionar valores reales.
M5_SERVICE_TOKEN=
# integration:up configura automáticamente una identidad de demo; no completar a mano.
# M5_DEMO_CLIENT_ID=99999999-9999-4999-8999-999999999999
M4_BASE_URL=http://localhost:3004
M4_TIMEOUT_MS=5000
# El stub rechaza la primera oferta y acepta la segunda para el E2E local.
M5_STUB_AUTO_RESPOND=true
# "m4" usa /api/v1/geocode y /api/v1/estimate reales; "stub" solo para tests.
ROUTE_RESOLVER_MODE=blocked
ROUTE_STUB_ORIGIN_LATITUDE=-27.4514
ROUTE_STUB_ORIGIN_LONGITUDE=-58.9867
ROUTE_STUB_DESTINATION_LATITUDE=-27.4692
ROUTE_STUB_DESTINATION_LONGITUDE=-58.8306
ROUTE_STUB_DISTANCE_KM=18.4
ROUTE_STUB_DURATION_MIN=28
DATABASE_URL=postgresql://m9:m9-local@localhost:5432/m9_reservas?schema=public
POSTGRES_DB=m9_reservas
POSTGRES_USER=m9
POSTGRES_PASSWORD=m9-local
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_CACHE_TTL_SECONDS=60
REDIS_LOCK_TTL_MS=10000
RABBITMQ_URL=amqp://m9:m9-local@localhost:5672
RABBITMQ_USER=m9
RABBITMQ_PASSWORD=m9-local
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PORT=5672
RABBITMQ_EXCHANGE=m9.reservas.events
RABBITMQ_RETRY_EXCHANGE=m9.reservas.events.retry
RABBITMQ_DLQ_EXCHANGE=m9.reservas.events.dlx
RABBITMQ_QUEUE=m9.reservas
RABBITMQ_RETRY_QUEUE=m9.reservas.retry
RABBITMQ_DLQ=m9.reservas.dlq
RABBITMQ_RETRY_LIMIT=3
RABBITMQ_RETRY_DELAY_MS=1000
OUTBOX_POLL_INTERVAL_MS=5000
RESERVATION_JOB_INTERVAL=*/5 * * * * *

# --- Observabilidad AE4 (OpenTelemetry -> Grafana Alloy -> Grafana Cloud) ---
# Apagada por defecto: el inicio normal y los tests no necesitan cuenta cloud.
# docker-compose.observability.yml la activa y apunta a http://alloy:4318.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=m9-reservas
DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=1
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
OTEL_EXPORT_TIMEOUT_MS=5000
OTEL_SHUTDOWN_TIMEOUT_MS=3000
OTEL_LOGS_ENABLED=true
OTEL_STATE_COLLECTOR_INTERVAL_MS=15000
OTEL_STUCK_ACTIVATION_THRESHOLD_SECONDS=120
# Las credenciales de Grafana Cloud NO van aquí: ver observability/grafana-cloud.env.example
