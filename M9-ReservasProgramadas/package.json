{
  "name": "m9-reservas-programadas",
  "version": "2.0.0",
  "private": true,
  "description": "Microservicio M9 para la gestión de reservas programadas.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "local:up": "docker compose --parallel 1 up --build -d",
    "local:down": "docker compose down",
    "integration:up": "node scripts/integration-demo.mjs up",
    "integration:stop": "node scripts/integration-demo.mjs stop",
    "integration:config": "node scripts/integration-demo.mjs config",
    "integration:obs:up": "node scripts/integration-demo.mjs up --with-obs",
    "integration:obs:stop": "node scripts/integration-demo.mjs stop --with-obs",
    "integration:obs:config": "node scripts/integration-demo.mjs config --with-obs",
    "integration:check": "node scripts/check-real-integration.mjs",
    "local:clean": "docker compose down --volumes --remove-orphans",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:coverage": "node scripts/run-infrastructure-tests.mjs --coverage",
    "test:e2e": "node scripts/run-compose-e2e.mjs",
    "test:e2e:only": "vitest run --config vitest.e2e.config.ts",
    "test:infrastructure": "node scripts/run-infrastructure-tests.mjs",
    "test:infrastructure:only": "vitest run --config vitest.infrastructure.config.ts",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "obs:up": "docker compose -f docker-compose.yml -f docker-compose.observability.yml --parallel 1 up --build -d",
    "obs:down": "docker compose -f docker-compose.yml -f docker-compose.observability.yml down",
    "obs:config": "docker compose -f docker-compose.yml -f docker-compose.observability.yml config --quiet",
    "obs:alloy:fmt": "docker run --rm -v ./observability/alloy:/etc/alloy:ro grafana/alloy:v1.21.3 fmt /etc/alloy/config.alloy",
    "obs:dashboards:check": "node scripts/check-grafana-assets.mjs",
    "telemetry:verify-export": "npm run build && node scripts/verify-otlp-export.mjs",
    "test:observability": "vitest run tests/unit/observability.test.ts tests/unit/observability-disabled.test.ts",
    "k6:smoke": "node scripts/run-k6.mjs smoke",
    "k6:load": "node scripts/run-k6.mjs load",
    "k6:stress": "node scripts/run-k6.mjs stress",
    "k6:spike": "node scripts/run-k6.mjs spike",
    "k6:cache": "node scripts/run-k6.mjs cache",
    "k6:concurrency": "node scripts/run-k6.mjs concurrency",
    "k6:activation": "node scripts/run-k6.mjs activation",
    "k6:dispatch": "node scripts/run-k6.mjs dispatch",
    "k6:repricing": "node scripts/run-k6.mjs repricing",
    "k6:smoke:cloud": "node scripts/run-k6.mjs smoke --cloud",
    "k6:load:cloud": "node scripts/run-k6.mjs load --cloud",
    "k6:stress:cloud": "node scripts/run-k6.mjs stress --cloud",
    "k6:spike:cloud": "node scripts/run-k6.mjs spike --cloud",
    "k6:cache:cloud": "node scripts/run-k6.mjs cache --cloud",
    "k6:concurrency:cloud": "node scripts/run-k6.mjs concurrency --cloud",
    "k6:dispatch:cloud": "node scripts/run-k6.mjs dispatch --cloud",
    "k6:repricing:cloud": "node scripts/run-k6.mjs repricing --cloud",
    "k6:cleanup": "node scripts/k6-cleanup.mjs",
    "obs:fault-drill": "node scripts/fault-drill.mjs",
    "obs:dashboards:build": "node scripts/build-grafana-dashboards.mjs",
    "k6:parallel": "node scripts/run-k6.mjs parallel",
    "k6:parallel:cloud": "node scripts/run-k6.mjs parallel --cloud",
    "k6:breakpoint": "node scripts/run-k6.mjs breakpoint",
    "k6:breakpoint:cloud": "node scripts/run-k6.mjs breakpoint --cloud",
    "k6:soak": "node scripts/run-k6.mjs soak",
    "k6:soak:cloud": "node scripts/run-k6.mjs soak --cloud",
    "auth:demo": "node scripts/demo-session.mjs",
    "integration:check:activation": "node scripts/check-real-integration.mjs --expect-assigned",
    "test:coverage:all": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:coverage:infra": "node scripts/run-infrastructure-tests.mjs --coverage",
    "test:coverage:unit": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-runtime-node": "0.38.0",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@prisma/client": "6.19.3",
    "@prisma/instrumentation": "6.19.3",
    "amqplib": "^2.1.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "node-cron": "4.6.0",
    "prisma": "6.19.3",
    "redis": "^6.2.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "magicast": "0.3.5",
    "prettier": "^3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.22.1"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
