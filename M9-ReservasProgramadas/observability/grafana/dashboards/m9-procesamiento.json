        "current": {}
      },
      {
        "name": "env",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, deployment_environment_name)",
          "refId": "env"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "current": {}
      },
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, service_name)",
          "refId": "service"
        },
        "refresh": 2,
        "current": {
          "text": "m9-reservas",
          "value": "m9-reservas"
