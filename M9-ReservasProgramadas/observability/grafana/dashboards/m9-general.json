{
  "uid": "m9-ae4-general",
  "title": "M9 Reservas · General",
  "description": "Tráfico, latencia, errores, runtime y salud de dependencias de M9. Para comparar con una prueba k6, ajustar el rango de tiempo a la ventana del test e ingresar su RUN_ID.",
  "tags": ["m9", "reservas", "ae4", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Métricas (Mimir)",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "loki",
        "label": "Logs (Loki)",
        "type": "datasource",
        "query": "loki",
        "current": {}
      },
      {
        "name": "tempo",
        "label": "Trazas (Tempo)",
        "type": "datasource",
        "query": "tempo",
        "current": {}
      },
      {
        "name": "env",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, deployment_environment_name)",
          "refId": "env"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "current": {}
      },
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, service_name)",
          "refId": "service"
        },
        "refresh": 2,
        "current": {
          "text": "m9-reservas",
          "value": "m9-reservas"
        }
      },
      {
        "name": "k6_run",
        "label": "RUN_ID k6",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "M9 · General",
      "type": "link",
      "url": "/d/m9-ae4-general",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "M9 · Reservas",
      "type": "link",
      "url": "/d/m9-ae4-reservas",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "M9 · Procesamiento",
      "type": "link",
      "url": "/d/m9-ae4-procesamiento",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Tráfico de negocio (/reservas)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Solicitudes por segundo por ruta y método",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (http_route, http_request_method) (rate(http_server_request_duration_seconds_count{service_name=\"$service\",deployment_environment_name=~\"$env\",m9_route_kind=\"business\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia p50 / p95 / p99 (negocio)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\",deployment_environment_name=~\"$env\",m9_route_kind=\"business\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\",deployment_environment_name=~\"$env\",m9_route_kind=\"business\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\",deployment_environment_name=~\"$env\",m9_route_kind=\"business\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
