      "id": 21,
      "type": "timeseries",
      "title": "Logs HTTP de la prueba k6 (RUN_ID)",
      "description": "Solicitudes de la prueba k6 (filtradas por RUN_ID) por código de estado, desde logs estructurados.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 8
      },
