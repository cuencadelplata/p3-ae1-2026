        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (statusCode) (count_over_time({service_name=\"$service\"} | message=\"http_request\" | correlationId=~\"$k6_run.*\" [$__interval]))",
          "legendFormat": "HTTP {{statusCode}}",
          "queryType": "range"
