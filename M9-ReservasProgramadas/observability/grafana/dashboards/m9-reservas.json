            "uid": "${datasource}"
          },
          "expr": "time() - max(m9_scheduler_last_success_timestamp_seconds{service_name=\"$service\",deployment_environment_name=~\"$env\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
