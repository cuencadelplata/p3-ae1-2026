      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (from, to) (increase(m9_reservation_transitions_total{service_name=\"$service\",deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{from}} → {{to}}",
          "range": true
