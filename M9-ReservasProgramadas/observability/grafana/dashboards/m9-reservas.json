          },
          "expr": "sum by (operation, cause) (increase(m9_reservation_pricing_degradations_total{service_name=\"$service\",deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{cause}}",
          "range": true
        }
