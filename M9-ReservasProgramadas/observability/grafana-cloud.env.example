# Copiar a observability/.env.grafana-cloud (archivo IGNORADO por git) y completar.
# Nunca versionar ni pegar estos valores en chats, capturas o issues.
#
# Dónde obtenerlos: Grafana Cloud Portal -> tu stack -> "OpenTelemetry" -> Configure.
#   - Endpoint OTLP del stack (termina en /otlp), p. ej.
#     https://otlp-gateway-prod-<region>.grafana.net/otlp
#   - Instance ID: número que se muestra en esa misma pantalla.
#   - Token: "Generate now" crea un Access Policy token. Permisos mínimos:
#       metrics:write, logs:write, traces:write  (solo escritura, sin lectura)

GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
GRAFANA_CLOUD_OTLP_INSTANCE_ID=000000
GRAFANA_CLOUD_OTLP_TOKEN=glc_REEMPLAZAR

# --- Grafana Cloud k6 (INDEPENDIENTE del token de ingesta anterior) ---
# Testing & synthetics -> Performance -> Settings -> Grafana Stack API token
# o personal API token. Se usa solo con `k6 cloud run --local-execution`.
K6_CLOUD_TOKEN=REEMPLAZAR
K6_CLOUD_STACK_ID=000000
K6_CLOUD_PROJECT_ID=000000
