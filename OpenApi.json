{
  "openapi": "3.0.4",
  "info": {
    "title": "Conductor API",
    "description": "Driver gateway API for the Conductor application.",
    "version": "0.1.9"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor local para realizar tests de la API"
    }
  ],
  "paths": {
    "/conductor/list": {
      "get": {
        "summary": "Listado de conductores",
        "responses": {
          "200": {
            "description": "Pedir la lista completa de conductores registrados en la base de datos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Conductor"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conductor/{id}": {
      "get": {
        "summary": "Obtener un conductor por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del conductor a obtener"
          }
        ],
        "responses": {
          "200": {
            "description": "Conductor encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conductor"
                }
              }
            }
          },
          "404": {
            "description": "Conductor no encontrado"
          }
        }
      }
    },
    "/conductor/create": {
      "post": {
        "summary": "Crear un nuevo conductor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Conductor"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conductor creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conductor"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          }
        }
      }
    }
  }
}