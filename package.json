{
  "name": "m9-reservas-programadas",
  "version": "0.1.0",
  "private": true,
  "description": "Microservicio M9 para la gestión de reservas programadas.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "supabase": "node scripts/run-supabase-cli.mjs",
    "local:up": "node scripts/run-local-stack.mjs up",
    "local:down": "node scripts/run-local-stack.mjs down",
    "local:clean": "node scripts/run-local-stack.mjs clean",
    "local:reset": "node scripts/run-local-stack.mjs reset",
    "test": "vitest run",
    "test:e2e": "node scripts/run-compose-e2e.mjs",
    "test:e2e:only": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "node-cron": "4.6.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supabase": "2.100.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
