{
  "name": "m2-clientes-api",
  "version": "1.0.0",
  "description": "Módulo 2 (Clientes) - RF-2.1, 2.2, 2.3, 2.4 y 2.5 - Paradigmas de Programación III",
  "main": "dist/server.js",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ae2": "npm run build && node --test tests/unit.test.cjs",
    "test:ae2:integration": "node --test --test-concurrency=1 tests/integration.test.cjs",
    "test:stack": "node --test tests/stack.test.cjs",
    "export:openapi": "tsx scripts/export-openapi.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "mock:m4": "node dist/mocks/modulo4.mock.js",
    "mock:m6": "node dist/mocks/modulo6.demo.js",
    "mock:m8": "node dist/mocks/modulo8.demo.js",
    "token": "node scripts/token.cjs",
    "offline": "node scripts/offline.cjs"
  },
  "keywords": [
    "microservices",
    "scalar",
    "openapi",
    "docker",
    "express",
    "typescript"
  ],
  "author": "Grupo 5",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@scalar/express-api-reference": "^0.4.184",
    "amqplib": "^0.10.9",
    "axios": "^1.6.7",
    "cockatiel": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "opossum": "^8.1.4",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/opossum": "^8.1.7",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.10.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "vitest": {
    "exclude": [
      "tests/e2e/**",
      "node_modules/**"
    ]
  }
}
