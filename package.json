{
  "name": "modulo2-clientes-ae2",
  "version": "2.2.0",
  "description": "AE2 RF-2.2 Direcciones frecuentes; conserva RF-2.4 de la base recibida",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "mock:m6": "node dist/mocks/modulo6.demo.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test": "npm run build && node --test tests/unit.test.cjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.cjs",
    "worker": "node dist/worker.js",
    "mock:m4": "node dist/mocks/modulo4.mock.js",
    "mock:m8": "node dist/mocks/modulo8.demo.js",
    "token": "node scripts/token.cjs",
    "db:migrate": "prisma migrate deploy",
    "test:stack": "node --test tests/stack.test.cjs",
    "offline": "node scripts/offline.cjs"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "prisma",
    "redis",
    "opossum",
    "circuit-breaker",
    "microservices"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "amqplib": "^0.10.9",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.3.2",
    "opossum": "^8.1.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/opossum": "^8.1.7",
    "prisma": "^5.10.2",
    "typescript": "^5.3.3"
  }
}
