# ---------- Etapa 1: compilar los frontends React de src/app ----------
# src/app/alta-conductor.tsx -> public/alta-conductor.js
# src/app/valoraciones.tsx   -> public/valoraciones.js
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY src/app/ ./src/app/
COPY public/ ./public/
RUN npm run build:front

# ---------- Etapa 2: servir con Nginx ----------
FROM nginx:alpine

# Configuración de Nginx (proxy /api/ -> http://api:3000)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# HTML estáticos + bundles recién compilados
COPY --from=build /app/public/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
