{

    "openapi": "3.0.3",
    "info": {
        "title": "Conductores API",
        "version": "1.0.0",
        "description": "Esta API se utilizará para la comunicación con los conductores, vehículos y viajes."
    },
"servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor local para realizar tests de la API"
    }
  ],
  "paths": {
    "/conductores": {
      "get": {
        "summary": "Listado de conductores",
        "responses": {
          "200": {
            "description": "Pedir la lista completa de conductores registrados en la base de datos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear un nuevo conductor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/conductores"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conductor creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/conductores"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          }
        }
      }
    },
    "/conductores/{id}": {
      "get": {
        "summary": "Obtener un conductor por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del conductor a obtener",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conductor encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/conductores/{id}"
                }
              }
            }
          },
          "404": {
            "description": "Conductor no encontrado"
          }
        }
      },
      "patch": {
        "summary": "Cambiar el tipo de vehículo de un conductor (corrección desde el alta)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tipovehiculo"],
                "properties": {
                  "tipovehiculo": { "type": "string", "enum": ["auto", "moto"], "description": "Se acepta en cualquier mayúscula/minúscula; se guarda en minúscula" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Conductor actualizado" },
          "400": { "description": "tipovehiculo inválido" },
          "404": { "description": "Conductor no encontrado" }
        }
      }
    },
     "/conductores/{id}/habilitado": {
      "get": {
        "summary": "Estado de habilitación del conductor (RF 3.1)",
        "description": "Resuelve primero contra la caché de Redis; si no está cacheado, consulta la base de datos y recarga la caché con TTL. Es la única vía permitida para que otros módulos consulten este dato (no deben hacer SQL directo).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "usuarioID del conductor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de habilitación obtenido (desde caché o base de datos)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "usuarioID": { "type": "string" },
                    "habilitado": { "type": "string", "enum": ["pendiente", "activo", "suspendido", "rechazado"] },
                    "origen": { "type": "string", "enum": ["cache", "db"] }
                  }
                }
              }
            }
          },
          "404": { "description": "Conductor no encontrado" }
        }
      }
    },
    "/conductores/{id}/disponible": {
      "get": {
        "summary": "Estado efímero de disponibilidad del conductor (RF 3.3)",
        "description": "Consulta exclusivamente Redis (clave con TTL tipo heartbeat), sin acceder a la base de datos, pensado para que el Módulo 5 la consulte de forma optimizada y frecuente durante el matching de viajes.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "usuarioID del conductor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de disponibilidad obtenido desde Redis (false si no hay heartbeat vigente)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "usuarioID": { "type": "string" },
                    "disponible": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conductores/": {
      "post": {
        "summary": "Crear un nuevo conductor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/conductores"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conductor creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/conductores"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          }
        }
      }
    },
    "/conductor/{id}/estado": {
      "get": {
        "summary": "Obtener estado de habilitación y disponibilidad de un conductor",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del conductor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado obtenido correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoConductor"
                }
              }
            }
          },
          "404": {
            "description": "Conductor no encontrado"
          }
        }
      }
    },
    "/conductor/{id}/habilitado": {
      "get": {
        "summary": "Consultar si un conductor está habilitado",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del conductor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de habilitación obtenido correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoConductor"
                }
              }
            }
          },
          "404": {
            "description": "Conductor no encontrado"
          }
        }
      }
    },
    "/conductor/{id}/disponible": {
      "get": {
        "summary": "Consultar si un conductor está disponible",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID del conductor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de disponibilidad obtenido correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoConductor"
                }
              }
            }
          },
          "404": {
            "description": "Conductor no encontrado"
          }
        }
      }
    },
    "/conductor/valoraciones": {
      "get": {
        "summary": "Listar valoraciones hechas por un conductor (evaluador) sobre pasajeros",
        "description": "Misma semántica que AsyncAPI: evaluador = conductor, evaluado = pasajero.",
        "parameters": [
          {
            "name": "evaluadorId",
            "in": "query",
            "required": false,
            "description": "usuarioID del conductor que realizó las valoraciones. Alias aceptado: conductorId.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "conductorId",
            "in": "query",
            "required": false,
            "description": "Alias de evaluadorId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Valoraciones del conductor (como evaluador) obtenidas correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/valoraciones"
                }
              }
            }
          },
          "400": {
            "description": "Falta evaluadorId o conductorId"
          }
        }
      },
      "post": {
        "summary": "Registrar valoración del pasajero hecha por el conductor",
        "description": "El conductor (evaluador) califica al pasajero (evaluado). Tras persistir, publica el evento valoracion.registrada en RabbitMQ (exchange valoraciones.events).",
        "parameters": [
          {
            "name": "evaluadorId",
            "in": "query",
            "required": false,
            "description": "usuarioID del conductor evaluador. También puede ir en el body. Alias: conductorId.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "conductorId",
            "in": "query",
            "required": false,
            "description": "Alias de evaluadorId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/nuevaValoracion"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Valoración registrada correctamente"
          },
          "400": {"description": "Solicitud inválida" }
        }
      }
    }
  },

  "components": {
    "schemas": {
    "nuevaValoracion": {
        "type": "object",
        "required": ["evaluadoId", "valoracion"],
        "properties": {
          "evaluadorId": {
            "type": "string",
            "description": "usuarioID del conductor que valora (alias: conductorId)"
          },
          "conductorId": {
            "type": "string",
            "description": "Alias de evaluadorId"
          },
          "evaluadoId": {
            "type": "string",
            "description": "usuarioID del pasajero evaluado (alias: clienteId / usuarioId)"
          },
          "clienteId": {
            "type": "string",
            "description": "Alias de evaluadoId"
          },
          "usuarioId": {
            "type": "string",
            "description": "Alias de evaluadoId (solo pasajero; no usar para el conductor)"
          },
          "valoracion": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "viajeId": {
            "type": "string",
            "description": "ID del viaje asociado a la valoración"
          },
          "comentario": {
            "type": "string",
            "description": "Comentario opcional sobre el pasajero evaluado"
          }
        }
      },

      "valoracion": {
        "type": "object",
        "required": ["id", "evaluadorId", "evaluadoId", "valoracion", "fecha"],
        "properties": {
          "id": { "type": "string" },
          "evaluadorId": {
            "type": "string",
            "description": "Conductor que valoró"
          },
          "evaluadoId": {
            "type": "string",
            "description": "Pasajero valorado"
          },
          "valoracion": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "comentario": { "type": "string" },
          "viajeId": {
            "type": "string",
            "nullable": true
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "valoraciones": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/valoracion"
        }
      },
      "Conductor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "apellido": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "telefono": {
            "type": "string"
          }
        },
        "required": ["id", "nombre", "apellido", "email", "telefono"]
      },
      "EstadoConductor": {
        "type": "object",
        "properties": {
          "usuarioID": {
            "type": "string"
          },
          "habilitado": {
            "type": "boolean"
          },
          "disponible": {
            "type": "boolean"
          },
          "estado": {
            "type": "string"
          },
          "estado_conexion": {
            "type": "string"
          }
        },
        "required": ["usuarioID", "habilitado", "disponible", "estado", "estado_conexion"]
      }
    }
  },
   "/viajes/{viajeId}": {
      "get": {
        "summary": "Obtener la información de un viaje",
        "parameters": [
          {
            "name": "viajeId",
            "in": "path",
            "required": true,
            "description": "ID del viaje para obtener su información",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Información del viaje obtenida correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/viaje",
                  "compontents": {
                    "schemas": {
                      "Viaje": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "conductorId": {
                            "type": "string"
                          },
                          "origen": {
                            "type": "string"
                          },
                          "destino": {
                            "type": "string"
                          },
                          "fechaHoraInicio": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "fechaHoraFin": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "estado": {
                            "type": "string",
                            "enum": ["pendiente", "en curso", "finalizado", "cancelado", "solicitado", "aceptado"]
                          }
                        },
                        "finalizadoAt":{
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },      
                        "required": ["id", "conductorId", "origen", "destino", "fechaHoraInicio", "finalizadoAt", "estado"]
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Viaje no encontrado"
          }
        }
      }

  }

  



}