# Configuración del servicio M7 en el Compose común.
# Copiar a modulo7/.env y completar por un canal privado.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
MP_ACCESS_TOKEN=

# Debe coincidir con M7_API_KEY en el .env de la raíz.
M7_API_KEY=

# Para el formulario de tarjeta, configurar MP_PUBLIC_KEY en el .env de la raíz.
