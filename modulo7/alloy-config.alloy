discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "m7_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-024.grafana.net/loki/api/v1/push"
    basic_auth {
      username = "1883301"
      password = "glc_eyJvIjoiMTk5MjkwOSIsIm4iOiJtNy1sb2dzLXRva2VuLW03LWxvZ3MtdG9rZW4iLCJrIjoiRjJyOWgwckM5akZhTDlmMEZqMnM0OThaIiwibSI6eyJyIjoicHJvZC11cy13ZXN0LTAifX0="
    }
  }
}

prometheus.scrape "m7" {
  targets = [{ __address__ = "m7-api:3000" }]
  scrape_interval = "15s"
  metrics_path    = "/metrics"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push"
    basic_auth {
      username = "3775266"
      password = "glc_eyJvIjoiMTk5MjkwOSIsIm4iOiJtNy1tZXRyaWNzLW03LXRva2VuIiwiayI6IjM5UmNOMFA1MDA1aDBwYjRLWmp6ZGNvOSIsIm0iOnsiciI6InByb2Qtc2EtZWFzdC0xIn19"
    }
