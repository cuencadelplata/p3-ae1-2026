# Configuración de Puertos
PORT_CONDUCTORES=3000
PORT_VEHICULOS=8083

# Supabase (compartido para tablas de conductores, vehiculos y documentos)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_real

# RabbitMQ (Broker común)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Redis (Caché común)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# OpenTelemetry (Métricas y Trazas)
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
GRAFANA_CLOUD_OTLP_USER=1919248
GRAFANA_CLOUD_API_KEY=<pegá_acá_lo_que_copiaste_del_botón_blanco>

# Loki (Logs de los contenedores Docker)
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-024.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=1919248