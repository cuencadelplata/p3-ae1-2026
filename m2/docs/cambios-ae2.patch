+  if(!key||!/^[a-zA-Z0-9_-]{8,100}$/.test(key)) throw new ApiError(400,'IDEMPOTENCY_REQUIRED','Enviar Idempotency-Key de 8 a 100 caracteres alfanuméricos, guion o guion bajo');
