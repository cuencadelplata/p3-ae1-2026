+  - name: Viajes
+    description: Operaciones relacionadas con viajes
+
+paths:
+  /api/viajes:
+    post:
+      tags:
+        - Viajes
+      summary: "RF-6.1: Solicitar un nuevo viaje"
+      description: Crea el viaje en estado SOLICITADO. M6 solicita el QR a M8 al registrar el arribo.
+      operationId: solicitarViaje
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/SolicitarViajeRequest'
+            examples:
+              ejemplo1:
+                summary: Solicitud básica
+                value:
+                  clienteId: cliente-123
+                  origen: Calle Principal 100
+                  destino: Centro Comercial
+      responses:
+        '201':
+          description: Viaje creado exitosamente
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ViajeResponse'
+              examples:
+                exitoso:
+                  summary: Respuesta exitosa
+                  value:
+                    id: "1725167854321"
+                    clienteId: cliente-123
+                    estado: SOLICITADO
+                    origen: Calle Principal 100
+                    destino: Centro Comercial
+                    codigoVerificacion: null
+                    qrCode: null
+                    qrExpiresAt: null
+                    fechaCreacion: "2026-09-01T15:30:00Z"
+        '503':
+          description: TripDB no disponible.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ErrorResponse'
+              examples:
+                db: { value: { error: "Base de datos no disponible, intente más tarde" } }
+
+  /api/viajes/{id}/asignar:
+    post:
+      tags:
+        - Viajes
+      summary: "RF-6.2: Asignar conductor a un viaje"
+      description: Asigna un conductor a un viaje en estado SOLICITADO y cambia a CONDUCTOR_EN_CAMINO
+      operationId: asignarConductor
+      parameters:
+        - $ref: '#/components/parameters/ViajeId'
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/AsignarConductorRequest'
+            examples:
+              ejemplo1:
+                summary: Asignar conductor
+                value:
+                  conductorId: conductor-001
+      responses:
+        '200':
+          description: Conductor asignado exitosamente
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/AsignarConductorResponse'
+        '400':
+          description: Error de validación (viaje no en estado SOLICITADO)
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ErrorResponse'
+        '404':
+          $ref: '#/components/responses/NotFound'
+        '503':
+          $ref: '#/components/responses/DbNoDisponible'
+
+  /api/viajes/{id}/arribo:
+    put:
+      tags:
+        - Viajes
+      summary: "RF-6.2: Registrar arribo del conductor"
+      description: |
+        Requiere estado CONDUCTOR_EN_CAMINO y conductor asignado. Consulta a M3 si el conductor está habilitado
+        (GET {M3_URL}/conductores/{id}/estado). La respuesta de M3 se cachea en Redis 60 s (clave conductor:{id}:estado).
+        Si M3 está caído o excede el timeout responde 503. Al éxito pasa a ARRIBADO, publica viaje.arribado,
+        y solicita a M8 el QR de vigencia limitada o reutiliza el vigente. La respuesta incluye token, imagen y vencimiento.
+      operationId: registrarArribo
+      parameters:
+        - $ref: '#/components/parameters/ViajeId'
+      responses:
+        '200':
+          description: Arribo registrado; QR generado o reutilizado mientras siga vigente.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/RegistrarArriboResponse'
+        '400':
+          description: Transición inválida (viaje no está en CONDUCTOR_EN_CAMINO) o viaje sin conductor asignado.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ErrorResponse'
+        '403':
+          description: M3 informa que el conductor no está habilitado.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ErrorResponse'
+              example: { error: "El conductor no está habilitado" }
+        '404':
+          $ref: '#/components/responses/NotFound'
+        '503':
+          description: TripDB o M8 no disponibles.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ErrorResponse'
+              example: { error: "No se pudo preparar el QR del viaje" }
+
+  /api/viajes/{id}/iniciar:
+    post:
+      tags:
+        - Viajes
+      summary: "RF-6.3: Iniciar viaje con validación de QR"
+      description: |
+        Requiere estado ARRIBADO. M6 envía {tripId, token} a M8 (POST /qr/validate).
+        Solo ante 200 {valid:true} cambia a EN_CURSO y publica viaje.iniciado. Los rechazos de M8
+        conservan ARRIBADO; ante 409/410 M6 solicita un QR nuevo si el viaje sigue ARRIBADO.
+        Los errores 503/timeout también conservan el estado e incluyen Retry-After cuando M8 lo informa.
+      operationId: iniciarViaje
+      parameters:
+        - $ref: '#/components/parameters/ViajeId'
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/IniciarViajeRequest'
+            examples:
+              exitoso:
+                summary: Código válido
+                value:
+                  codigoVerificacion: "AB3K8F"
+              invalido:
+                summary: Código inválido
+                value:
+                  codigoVerificacion: "INCORRECTO"
+      responses:
+        '200':
+          description: Viaje iniciado exitosamente
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/IniciarViajeResponse'
+        '400':
+          description: Error de validación (viaje no en estado ARRIBADO)
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ErrorResponse'
+        '401':
+          description: Código de verificación local inválido o M8 devolvió valid:false.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ErrorResponse'
+              example: { error: { code: QR_INVALID } }
+        '404':
+          description: El viaje o el QR no existe.
+          content:
+            application/json:
+              schema:
+                oneOf:
+                  - $ref: '#/components/schemas/ErrorResponse'
+                  - $ref: '#/components/schemas/M8ErrorResponse'
+              example: { error: { code: QR_NOT_FOUND } }
+        '409':
+          description: QR usado; si el viaje sigue ARRIBADO, se devuelve un QR nuevo.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/M8ErrorResponse'
+              example: { error: { code: QR_ALREADY_USED }, qr: { token: nuevoToken, qrDataUrl: dataUrl, expiresAt: "2026-10-05T12:05:00Z" } }
+        '410':
+          description: QR expirado; si el viaje sigue ARRIBADO, se devuelve un QR nuevo.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/M8ErrorResponse'
+              example: { error: { code: QR_EXPIRED }, qr: { token: nuevoToken, qrDataUrl: dataUrl, expiresAt: "2026-10-05T12:05:00Z" } }
+        '500':
+          description: Error inesperado de M8 al validar.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ErrorResponse'
+        '503':
+          description: M8 no disponible o timeout, o TripDB no disponible.
+          headers:
+            Retry-After:
+              description: Tiempo sugerido antes de reintentar, cuando lo informa M8.
+              schema: { type: string }
+          content:
+            application/json:
+              schema:
+                oneOf:
+                  - $ref: '#/components/schemas/ErrorResponse'
+                  - $ref: '#/components/schemas/M8ErrorResponse'
+              example: { error: "Servicio de validación temporalmente no disponible. Intente nuevamente." }
+
+components:
+  schemas:
+    EstadoViaje:
+      type: string
+      enum:
+        - SOLICITADO
+        - ASIGNADO
+        - CONDUCTOR_EN_CAMINO
+        - ARRIBADO
+        - EN_CURSO
+        - COMPLETADO
+        - CANCELADO
+      description: Estados posibles del viaje
+
+    SolicitarViajeRequest:
+      type: object
+      required:
+        - clienteId
+        - origen
+        - destino
+      properties:
+        clienteId:
+          type: string
+          description: Identificador único del cliente
+          example: cliente-123
+        origen:
+          type: string
+          description: Dirección de origen del viaje
+          example: Calle Principal 100
+        destino:
+          type: string
+          description: Dirección de destino del viaje
+          example: Centro Comercial
+
+    ViajeResponse:
+      type: object
+      properties:
+        id:
+          type: string
+          description: UUID v4 del viaje
+          example: "3f0c9c1e-6a51-4d0e-9b57-0c2d1a7f4b11"
+        clienteId:
+          type: string
+          description: ID del cliente que solicitó el viaje
+          example: cliente-123
+        conductorId:
+          type: string
+          nullable: true
+          description: ID del conductor asignado (null si no está asignado)
+          example: null
+        estado:
+          $ref: '#/components/schemas/EstadoViaje'
+        origen:
+          type: string
+          example: Calle Principal 100
+        destino:
+          type: string
+          example: Centro Comercial
+          codigoVerificacion:
+            type: string
+            nullable: true
+            description: Token asociado al QR vigente, nulo hasta registrar ARRIBADO.
+            example: "AB3K8F"
+        qrCode:
+          type: string
+          nullable: true
+            description: Data URL del QR vigente; nulo hasta registrar ARRIBADO.
+          qrExpiresAt:
+            type: string
+            format: date-time
+            nullable: true
+            description: Expiración del QR; nula hasta registrar ARRIBADO.
+        fechaCreacion:
+          type: string
+          format: date-time
+          description: Timestamp de creación del viaje
+          example: "2026-09-01T15:30:00Z"
+
+    AsignarConductorRequest:
+      type: object
+      required:
+        - conductorId
+      properties:
+        conductorId:
+          type: string
+          description: Identificador único del conductor a asignar
+          example: conductor-001
+
+    AsignarConductorResponse:
+      type: object
+      properties:
+        mensaje:
+          type: string
+          example: "Conductor asignado. Su conductor está en camino a su dirección"
+        viaje:
+          $ref: '#/components/schemas/ViajeResponse'
+
+    RegistrarArriboResponse:
+      type: object
+      properties:
+        mensaje:
+          type: string
+          example: "El conductor ha arribado"
+        viaje:
+          $ref: '#/components/schemas/ViajeResponse'
+        qr:
+          $ref: '#/components/schemas/QRResponse'
+
+    QRResponse:
+      type: object
+      required: [token, qrDataUrl, expiresAt]
+      properties:
+        token: { type: string }
+        qrDataUrl: { type: string, format: uri }
+        expiresAt: { type: string, format: date-time }
+
+    IniciarViajeRequest:
+      type: object
+      required:
+        - codigoVerificacion
+      properties:
+        codigoVerificacion:
+          type: string
+          description: Código extraído del QR para validar
+          example: "AB3K8F"
+
+    IniciarViajeResponse:
+      type: object
+      properties:
+        mensaje:
+          type: string
+          example: "Viaje iniciado"
+        viaje:
+          $ref: '#/components/schemas/ViajeResponse'
+
+    ErrorResponse:
+      type: object
+      properties:
+        error:
+          type: string
+          description: Mensaje de error descriptivo
+          example: "Viaje no encontrado"
+
+    M8ErrorResponse:
+      type: object
+      required: [error]
+      properties:
+        error:
+          type: object
+          required: [code]
+          properties:
+            code:
+              type: string
+              example: QR_EXPIRED
+        qr:
+          $ref: '#/components/schemas/QRResponse'
+
+  parameters:
+    ViajeId:
+      name: id
+      in: path
+      description: UUID del viaje
+      required: true
+      schema:
+        type: string
+        format: uuid
+      example: "3f0c9c1e-6a51-4d0e-9b57-0c2d1a7f4b11"
+
+  responses:
+    DbNoDisponible:
+      description: TripDB no disponible
+      content:
+        application/json:
+          schema:
+            $ref: '#/components/schemas/ErrorResponse'
+          example:
+            error: "Base de datos no disponible, intente más tarde"
+
+    NotFound:
+      description: Viaje no encontrado
+      content:
+        application/json:
+          schema:
+            $ref: '#/components/schemas/ErrorResponse'
+          example:
+            error: "Viaje no encontrado"
