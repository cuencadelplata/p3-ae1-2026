+  else if(err.type==='entity.parse.failed'){status=400;code='INVALID_JSON';message='JSON inválido';}
+  else if(err.type==='entity.too.large'){status=413;code='PAYLOAD_TOO_LARGE';message='Cuerpo demasiado grande';}
