+info:
+  title: M6 - Viajes y Ciclo de Vida
+  description: |
+    API de M6 (Viajes y Ciclo de Vida). AE2: RF-6.1 (estados), RF-6.2 (arribo validado con M3, caché Redis) y RF-6.3 (inicio validado con QR de M8).
+    Eventos asíncronos (RabbitMQ) documentados en AE2-M6-documentacion.md.
+  version: 2.0.0
+  contact:
+    name: Equipo M6
+  license:
+    name: ISC
+
+servers:
+  - url: http://localhost:3000
+    description: Servidor de desarrollo
+
