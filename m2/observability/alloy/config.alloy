// Grafana Alloy: intermediario entre M2 y Grafana Cloud.
// Flujo: scrape (API) y receive_http (k6) → relabel (filtra y etiqueta) → remote_write (Grafana Cloud).
// Las credenciales salen de variables de entorno (GRAFANA_CLOUD_*), cargadas desde m2/.env.

// 1. Lee las métricas de la API de M2 cada 15 s.
prometheus.scrape "m2_api" {
  targets = [{
    "__address__" = "api:3000",
    "job"         = "m2-clientes",
  }]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.m2.receiver]
}

// 2. Recibe las métricas que manda k6 (-o experimental-prometheus-rw).
//    URL para k6: http://alloy:9999/api/v1/metrics/write
prometheus.receive_http "k6" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9999
  }
  forward_to = [prometheus.relabel.m2.receiver]
}

// 3. Deja solo las series de M2 y de k6 y les agrega modulo="m2",
//    así no se mezclan si el stack de Grafana Cloud es compartido entre módulos.
prometheus.relabel "m2" {
  rule {
    source_labels = ["__name__"]
    regex         = "m2_.*|k6_.*|up"
    action        = "keep"
  }
  rule {
    target_label = "modulo"
    replacement  = "m2"
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// 4. Envía a Grafana Cloud. Sin credenciales válidas este paso falla,
//    pero los pasos 1 a 3 siguen funcionando.
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
