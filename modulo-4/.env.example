# M4 - Ubicación y Disponibilidad - Variables de Entorno (AE2)
PORT=3004
NODE_ENV=development
LOCATION_TTL_SECONDS=60

# Auth M1 (Requerimiento 5)
M1_URL=http://localhost:3001
SKIP_AUTH_VALIDATION=false

# M3 (Requerimiento 6)
M3_URL=http://localhost:3003

# Redis Cache (Requerimiento 3: driver:{driverId}:location)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=driver:

# PostgreSQL Location History (Requerimiento 4)
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/m4_locations

# RabbitMQ Asynchronous Integration (Requerimiento 8)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_TRIP_EVENTS_EXCHANGE=trip.events
RABBITMQ_TRIP_STARTED_KEY=TripStarted
RABBITMQ_TRIP_COMPLETED_KEY=TripCompleted
RABBITMQ_TRIP_CANCELLED_KEY=TripCancelled

# External Geocoding Provider Config
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org/search
GEOCODING_API_KEY=
GEOCODING_TIMEOUT_MS=5000
USE_MOCK_GEOCODING=true
